__pycache__/
*.pyc
*.tfvars
.terraform
tfplan
# Local OpenTofu backend overrides (CI uses -backend-config from GitHub vars).
**/backend.hcl

# Terraform state records live resource metadata and can carry secrets in
# plaintext attributes. The general rule keeps stray local state out of git.
# EXCEPTION: aws-cloud-discovery PRs must commit the scanned monolith state
# (aws/artifacts/cloud2code/<region>/terraform.tfstate) and the per-group
# shards (aws/groups/<group>/terraform.tfstate) — they are the run's core
# artifact and the pack force-adds them (trace 1c64c4a5).
*.tfstate
*.tfstate.*
*.tfstate.backup
!aws/artifacts/cloud2code/**
!aws/groups/**/*.tfstate
!aws/groups/**/*.tfstate.backup
agent-pipeline-config/tfvars/*.json

# Local runner / Helm values often embed mothership tokens — never commit.
**/runner-helm-values.yaml
runner/dist/
**/*-helm-values.local.yaml
session-report.json
**/session-report.json
tfplan.*
