            ],
            "stage_bindings": [
              {
                "action_config": {},
                "action_type": "",
                "agent_ref": "aws-migrator-architect",
                "note": "**Purpose:** start from an already-generated AWS IaC split branch instead of rerunning cloud2code/decomposition.\n**Handoff:** prefer workflow input / note `source_pr` (GitHub PR number) → `gh pr view` head branch; else `source_iac_branch` (default `fixture/opa-gcp-source-mini`). Optional `source_iac_repository_url` (default `https://github.com/Walmart-StackGen/Nile-Factory.git`).\n**Incremental bring-up execution (mandatory):** `create_agent` is allowed (reactree). Put the exact BEGIN/END one-liner in CREATE_AGENT_EXPECTATION (`tool_names` only execute_series), or paste it yourself. ONE `nile-runner_execute_series` with `commands[0].command` set to the **exact character-for-character** one-line body between `---BEGIN AZURE_SOURCE_FETCH_EXECUTE_SERIES---` and `---END AZURE_SOURCE_FETCH_EXECUTE_SERIES---` (starts with `SOURCE_PR=`, downloads `pack-entry.sh`, ends with `destination azure-source-fetch`). **FORBIDDEN:** (1) `command=\"AZURE_SOURCE_FETCH_EXECUTE_SERIES\"`; (2) pasting only `BEGIN` or a fragment; (3) composing your own shell; (4) rewriting the pack path. **RIGHT:** copy the full one-line BEGIN/END body unchanged; if user input has `source_iac_branch=…`, set only the `SOURCE_IAC_BRANCH='…'` segment.\n**Hard evidence gate:** completion requires a successful runner result with `azure_source_iac_fetched=true` and `azure_source_iac_group_count` greater than zero. Absent those, record `stage_summary:azure-source-fetch=blocked:missing_runner_evidence` and return blocked.\n**Outputs:** `$WORK_ROOT/groups`, `$WORK_ROOT/logical_group_manifest.json`, `$WORK_ROOT/source_aws/`, notes `azure_source_iac_fetched=true`, `azure_source_iac_group_count`, `source_iac_repository_url`, `source_iac_branch`, and `stage_summary:azure-source-fetch=ok`.\n**Forbidden:** cloud2code, tfstate splitting, AWS reverse-HCL hydration, StackGen MCP tools, AppStacks, or asking for the branch path.\n\nThe exact spawn context follows. Put this BEGIN/END body in CREATE_AGENT_EXPECTATION\n(or paste it yourself). Never invent a replacement command:\n\nworkflow_run_id: {{workflow_run_id}}\nWORK_ROOT: /home/runner/.{{workflow_run_id}}\nABS_WORK_ROOT: /home/runner/.{{workflow_run_id}}\nrunner_work_home: /home/runner\nremote_runner_name: nile-runner\nshell_tool_prefix: nile-runner\nscript_pack_version: 20260930.05\nscript_pack_preload_dir: /opt/aws-migrator/script-pack/20260930.05\n\ndefault_source_iac_repository_url: https://github.com/Walmart-StackGen/Nile-Factory.git\ndefault_source_iac_branch: fixture/opa-gcp-source-mini\n\n---BEGIN AZURE_SOURCE_FETCH_EXECUTE_SERIES---\nexport SOURCE_PR='' SOURCE_IAC_BRANCH='fixture/opa-gcp-source-mini' SOURCE_IAC_REPOSITORY_URL='https://github.com/Walmart-StackGen/Nile-Factory.git' IAC_REPOSITORY_URL='https://github.com/Walmart-StackGen/Nile-Factory.git' DEFAULT_BRANCH='main' WORKFLOW_RUN_ID='{{workflow_run_id}}' DBSPLIT_EMBEDDED=1 GIT_TOKEN=\"${GIT_TOKEN:-${GITHUB_TOKEN:-${GH_TOKEN:-${token:-}}}}\"; export GIT_TOKEN; export GH_TOKEN=\"${GH_TOKEN:-${GIT_TOKEN}}\"; export GITHUB_TOKEN=\"${GITHUB_TOKEN:-${GIT_TOKEN}}\"; export GIT_TERMINAL_PROMPT=0; unset AWS_PROFILE; rm -rf \"${HOME}/.aws/cli/cache\" \"${HOME}/.aws/sso\" 2\u003e/dev/null || true; echo \"aws_env_keys=$(env | grep '^AWS_' | cut -d= -f1 | tr '\\n' ' ')\"; if [ -f \"${HOME}/.aws/credentials\" ]; then echo aws_credentials_file=present; else echo aws_credentials_file=absent; fi; pack_entry(){ P='/opt/aws-migrator/script-pack/20260930.05'; if [ -x \"${P}/pack-entry.sh\" ]; then exec bash \"${P}/pack-entry.sh\" \"$@\"; fi; D=$(mktemp -d); gh release download 'pack-20260930.05' -R 'Walmart-StackGen/Nile-Factory' -p pack-entry.sh -D \"${D}\" \u0026\u0026 exec bash \"${D}/pack-entry.sh\" \"$@\"; }; pack_entry destination azure-source-fetch '{{workflow_run_id}}'\n\n---END AZURE_SOURCE_FETCH_EXECUTE_SERIES---\n\n",
                "parallel_agents": [],
                "runbook_refs": [
                  "aws-migrator-azure-migration-profile-sop",
                  "aws-migrator-orchestration-sop"
                ],
                "skill_refs": [
                  "aws-migrator-azure-migration-profile-sop",
