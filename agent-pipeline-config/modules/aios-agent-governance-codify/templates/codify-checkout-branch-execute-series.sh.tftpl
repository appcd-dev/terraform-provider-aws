set -eu; TGT='{{TARGET_DIR}}'; TGT_REPO='{{TARGET_REPO}}'; BRANCH='CODIFY_BRANCH'; if git -C "$TGT" rev-parse HEAD >/dev/null 2>&1; then git -C "$TGT" fetch origin "$BRANCH" --depth=1 && git -C "$TGT" checkout "$BRANCH"; else rm -rf "$TGT" 2>/dev/null || true; gh repo clone "$TGT_REPO" "$TGT" -- --branch "$BRANCH" --single-branch --depth 1; fi; git -C "$TGT" rev-parse HEAD && git -C "$TGT" log --oneline -1
