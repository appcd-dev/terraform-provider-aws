cd {{CLONE_DIR}} && set -eu && BRANCH='{{BRANCH}}' && if git ls-remote --exit-code --heads origin "$${BRANCH}" >/dev/null 2>&1; then BRANCH="$${BRANCH}-$(date -u +%H%M%S)"; git branch -m "$${BRANCH}"; fi && git push -u origin "$${BRANCH}" && gh pr create --repo {{OWNER}}/{{REPO}} --base {{BASE_BRANCH}} --head "$${BRANCH}" --title "{{PR_TITLE}}" --body "{{PR_BODY_LINE1}}. {{PR_BODY_LINE2}}. Created using [StackGen](https://ai.stackgen.com)"
