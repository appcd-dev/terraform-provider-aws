cd {{CLONE_DIR}} && set -eu && BASE='{{BASE_BRANCH}}' && REPO='{{TARGET_REPO}}' && PREF='SOURCE_COMMIT_SHA' && if ! git rev-parse HEAD >/dev/null 2>&1; then rm -rf ./* ./.[!.]* 2>/dev/null || true; gh repo clone "$REPO" . -- --branch "$BASE" --single-branch --depth 1; fi && git fetch origin --prune "$BASE" && best= && best_ts=0 && for b in $(git for-each-ref --format='%(refname:strip=3)' refs/remotes/origin); do echo "$b" | grep -Eq '^[0-9a-f]{40}_[0-9]{14}$' || continue; if [ -n "$PREF" ] && [ "$PREF" != 'SOURCE_COMMIT_SHA' ]; then case "$b" in "$PREF"_*) ;; *) continue ;; esac; fi; ahead=$(git rev-list --count "origin/$BASE..origin/$b" 2>/dev/null || echo 0); if [ "$ahead" -gt 0 ]; then ts=$${b#*_}; if [ "$ts" -gt "$best_ts" ]; then best_ts=$ts; best=$b; fi; fi; done && if [ -z "$best" ]; then echo codify_branch=; echo codify_branch_recover=failed; exit 1; fi && printf 'codify_branch=%s\n' "$best" && printf 'codify_branch_ahead=%s\n' "$(git rev-list --count "origin/$BASE..origin/$best")" && echo codify_branch_recover=ok
