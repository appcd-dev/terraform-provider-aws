set -eu; SRC='{{SOURCE_DIR}}'; TGT='{{TARGET_DIR}}'; SRC_REPO='{{SOURCE_REPO}}'; TGT_REPO='{{TARGET_REPO}}'; SRC_REF='{{SOURCE_REF}}'; TGT_REF='{{TARGET_REF}}'; sync_repo(){ local repo="$1" dir="$2" ref="$3"; if git -C "$dir" rev-parse HEAD >/dev/null 2>&1; then git -C "$dir" fetch origin "$ref" --depth=1 && git -C "$dir" checkout "$ref" && git -C "$dir" reset --hard "origin/$ref"; else rm -rf "$dir" 2>/dev/null || true; gh repo clone "$repo" "$dir" -- --branch "$ref" --single-branch --depth 1; fi; git -C "$dir" rev-parse HEAD; }; sync_repo "$SRC_REPO" "$SRC" "$SRC_REF"; sync_repo "$TGT_REPO" "$TGT" "$TGT_REF"
