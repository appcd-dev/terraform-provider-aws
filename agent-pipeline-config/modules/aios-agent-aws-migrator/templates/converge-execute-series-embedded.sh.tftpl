/bin/bash <<'DBSPLIT_CONVERGE_EXECUTE'
set -euo pipefail
export HOME=${runner_work_home}
ABS_WORK_ROOT="${runner_work_home}/.{{workflow_run_id}}"
WORK_ROOT="$ABS_WORK_ROOT"
export DBSPLIT_EMBEDDED=1
export DBSPLIT_ALLOCATE_SHA256="${script_pack_allocate_sha256}"
export DBSPLIT_DECOMPOSER_SHA256="${script_pack_decomposer_sha256}"

${dbsplit_script_pack_preload_helpers}

if ! dbsplit_ensure_script_pack "$WORK_ROOT"; then
  exit 1
fi
bash -s hydrate-and-plan-matrix "$WORK_ROOT" < "$WORK_ROOT/scripts/stage-runner.sh"
if [ -f "$WORK_ROOT/notes.json" ] && [ "$(jq -r '.multi_plan_zero_diff_ok // ""' "$WORK_ROOT/notes.json")" = "true" ]; then
  IAC_REPOSITORY_URL="$(jq -r --arg d "${default_iac_repository_url}" '.iac_repository_url // $d' "$WORK_ROOT/notes.json")"
  DEFAULT_BRANCH="$(jq -r --arg d "${default_branch}" '.default_branch // $d' "$WORK_ROOT/notes.json")"
  bash -s sync-hydrated-iac-pr "$WORK_ROOT" "$${IAC_REPOSITORY_URL}" "$${DEFAULT_BRANCH}" "{{workflow_run_id}}" \
    < "$WORK_ROOT/scripts/stage-runner.sh"
fi
DBSPLIT_CONVERGE_EXECUTE
