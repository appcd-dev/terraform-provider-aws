set -euo pipefail
# Preloaded as ${script_pack_preload_dir}/converge-bootstrap.sh.
# Stage note pastes only: WORKFLOW_RUN_ID='…' DBSPLIT_EMBEDDED=1 bash …/converge-bootstrap.sh
export HOME=${runner_work_home}
export WORKFLOW_RUN_ID="$${WORKFLOW_RUN_ID:-$${1:-}}"
if [ -z "$${WORKFLOW_RUN_ID}" ] || printf '%s' "$${WORKFLOW_RUN_ID}" | grep -q '{{'; then
  echo "error=WORKFLOW_RUN_ID_unset argv_count=$#" >&2
  exit 1
fi
ABS_WORK_ROOT="${runner_work_home}/.$${WORKFLOW_RUN_ID}"
WORK_ROOT="$ABS_WORK_ROOT"
export DBSPLIT_EMBEDDED=1
export DBSPLIT_ALLOCATE_SHA256="${script_pack_allocate_sha256}"
export DBSPLIT_DECOMPOSER_SHA256="${script_pack_decomposer_sha256}"
# SCM github vault sync exposes `token` (session 8da4f049). Alias for git/gh.
export GIT_TOKEN="$${GIT_TOKEN:-$${GITHUB_TOKEN:-$${GH_TOKEN:-$${token:-}}}}"
export GH_TOKEN="$${GH_TOKEN:-$${GIT_TOKEN}}"
export GITHUB_TOKEN="$${GITHUB_TOKEN:-$${GIT_TOKEN}}"
export GIT_TERMINAL_PROMPT=0

${dbsplit_script_pack_preload_helpers}

if ! dbsplit_ensure_script_pack "$WORK_ROOT"; then
  exit 1
fi
# The manifest is the ingest prerequisite. batch_payloads.json is generated
# by prepare-parallel-artifacts inside this converge visit.
if [ ! -s "$WORK_ROOT/logical_group_manifest.json" ]; then
  echo 'blocked:converge_inputs_missing: "true"'
  echo "converge_input_error=missing_logical_group_manifest work_root=$WORK_ROOT"
  exit 1
fi
bash -s hydrate-and-plan-matrix "$WORK_ROOT" < "$WORK_ROOT/scripts/stage-runner.sh" || true
# Always push generated.tf to the discovery PR. Validation / zero-diff stay soft
# signals — losing hydrate work when fmt/validate fails wastes the scan.
# hydrate may soft-fail, batch-cap incomplete, or leave a checkpoint after OOM;
# do not let set -e skip the sync.
# Matrix resumes already-green groups. Default visit cap is unlimited (0) and a
# 20m wall-clock budget defers the rest inside the 30m nile-runner window;
# shell-converge-loop GO_BACKs until hydrate_groups_remaining=0 before Ready.
IAC_REPOSITORY_URL="$(jq -r --arg d "${default_iac_repository_url}" '.iac_repository_url // $d' "$WORK_ROOT/notes.json" 2>/dev/null || echo "${default_iac_repository_url}")"
DEFAULT_BRANCH="$(jq -r --arg d "${default_branch}" '.default_branch // $d' "$WORK_ROOT/notes.json" 2>/dev/null || echo "${default_branch}")"
bash -s sync-hydrated-iac-pr "$WORK_ROOT" "$${IAC_REPOSITORY_URL}" "$${DEFAULT_BRANCH}" "$${WORKFLOW_RUN_ID}" \
  < "$WORK_ROOT/scripts/stage-runner.sh" || true
