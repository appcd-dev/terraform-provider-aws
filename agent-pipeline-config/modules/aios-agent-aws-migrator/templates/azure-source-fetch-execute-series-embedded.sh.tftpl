/bin/bash <<'DBSPLIT_AZURE_SOURCE_FETCH_EXECUTE'
set -euo pipefail
export HOME=${runner_work_home}
ABS_WORK_ROOT="${runner_work_home}/.{{workflow_run_id}}"
WORK_ROOT="$ABS_WORK_ROOT"
export DBSPLIT_EMBEDDED=1
export DBSPLIT_ALLOCATE_SHA256="${script_pack_allocate_sha256}"
export DBSPLIT_DECOMPOSER_SHA256="${script_pack_decomposer_sha256}"
export SOURCE_IAC_REPOSITORY_URL="${default_iac_repository_url}"
export SOURCE_IAC_BRANCH="${azure_only_source_branch}"
export SOURCE_PR=""
export IAC_REPOSITORY_URL="${default_iac_repository_url}"
export DEFAULT_BRANCH="${default_branch}"
export WORKFLOW_RUN_ID="{{workflow_run_id}}"

${dbsplit_script_pack_preload_helpers}

if ! dbsplit_ensure_script_pack "$WORK_ROOT"; then
  exit 1
fi
mkdir -p "$WORK_ROOT" "$WORK_ROOT/.work"
# Prefer operator handoff file (written by the lead before this series), then notes.
if [ -f "$WORK_ROOT/.work/source-handoff-inputs.json" ]; then
  SOURCE_IAC_REPOSITORY_URL="$(jq -r --arg d "$${SOURCE_IAC_REPOSITORY_URL}" '.source_iac_repository_url // .iac_repository_url // $d' "$WORK_ROOT/.work/source-handoff-inputs.json")"
  SOURCE_IAC_BRANCH="$(jq -r --arg d "$${SOURCE_IAC_BRANCH}" '.source_iac_branch // $d' "$WORK_ROOT/.work/source-handoff-inputs.json")"
  SOURCE_PR="$(jq -r '.source_pr // .source_iac_pr // empty' "$WORK_ROOT/.work/source-handoff-inputs.json")"
  DEFAULT_BRANCH="$(jq -r --arg d "$${DEFAULT_BRANCH}" '.default_branch // $d' "$WORK_ROOT/.work/source-handoff-inputs.json")"
fi
if [ -f "$WORK_ROOT/notes.json" ]; then
  SOURCE_IAC_REPOSITORY_URL="$(jq -r --arg d "$${SOURCE_IAC_REPOSITORY_URL}" '.source_iac_repository_url // .iac_repository_url // $d' "$WORK_ROOT/notes.json")"
  # Only fall back to notes branch when SOURCE_PR is empty — otherwise PR head wins in stage-runner.
  if [ -z "$${SOURCE_PR}" ]; then
    SOURCE_IAC_BRANCH="$(jq -r --arg d "$${SOURCE_IAC_BRANCH}" '.source_iac_branch // .iac_push_branch // .working_branch // $d' "$WORK_ROOT/notes.json")"
    SOURCE_PR="$(jq -r '.source_pr // .source_iac_pr // empty' "$WORK_ROOT/notes.json")"
  fi
  DEFAULT_BRANCH="$(jq -r --arg d "$${DEFAULT_BRANCH}" '.default_branch // $d' "$WORK_ROOT/notes.json")"
fi
export SOURCE_PR
bash -s azure-source-fetch "$WORK_ROOT" "$${SOURCE_IAC_REPOSITORY_URL}" "$${SOURCE_IAC_BRANCH}" "$${DEFAULT_BRANCH}" \
  < "$WORK_ROOT/scripts/stage-runner.sh"
DBSPLIT_AZURE_SOURCE_FETCH_EXECUTE
