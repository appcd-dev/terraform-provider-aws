/bin/bash <<'DBSPLIT_AZURE_VALIDATE_EXECUTE'
set -euo pipefail
export HOME=${runner_work_home}
ABS_WORK_ROOT="${runner_work_home}/.{{workflow_run_id}}"
WORK_ROOT="$ABS_WORK_ROOT"
export DBSPLIT_EMBEDDED=1
export DBSPLIT_ALLOCATE_SHA256="${script_pack_allocate_sha256}"
export DBSPLIT_DECOMPOSER_SHA256="${script_pack_decomposer_sha256}"
export REQUIRE_AZURE_LIVE_PLAN="${require_azure_live_plan}"
# Sample live plans only; static fmt/validate covers every group unless overridden.
export AZURE_LIVE_PLAN_MAX_GROUPS="8"
unset AZURE_VALIDATE_MAX_GROUPS || true

${dbsplit_script_pack_preload_helpers}

if ! dbsplit_ensure_script_pack "$WORK_ROOT"; then
  exit 1
fi
bash -s azure-iac-validate "$WORK_ROOT" < "$WORK_ROOT/scripts/stage-runner.sh"
DBSPLIT_AZURE_VALIDATE_EXECUTE
